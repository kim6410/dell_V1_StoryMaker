# Google Cloud Console에서 만든 Web application OAuth client ID
STORYMAKER_GOOGLE_CLIENT_ID=

# Supertonic / Podcast API
SUPERTONIC_API_KEY=

# WordPress REST API 자동 초안 등록
# 내부 Docker WordPress를 쓸 때 기본값
WORDPRESS_API_URL=http://storymaker_wp/wp-json/wp/v2

# WordPress 관리자 계정 또는 글 작성 권한 계정
WORDPRESS_USERNAME=

# WordPress 사용자 프로필에서 발급한 Application Password
# 예: xxxx xxxx xxxx xxxx xxxx xxxx
WORDPRESS_APP_PASSWORD=
