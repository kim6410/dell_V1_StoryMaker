# ==============================================================================
# StoryMaker 웹앱 백엔드 환경 설정 샘플 (.env.example)
# 실제 배포 시 이 파일을 '.env'로 복사하여 사용하십시오.
# ==============================================================================

# 실행 환경 설정 (development, production)
STORYMAKER_ENV=production

# ------------------------------------------------------------------------------
# 데이터베이스 및 저장소 경로 설정 (Windows 스타일 절대 경로 사용 금지)
# ------------------------------------------------------------------------------

# [로컬 실행 기본값]
STORYMAKER_DB_PATH=/home/bourne/StoryMaker_1/database/storymaker.db
STORYMAKER_PERSONA_DIR=/home/bourne/StoryMaker_1/personas
STORYMAKER_OUTPUT_DIR=/home/bourne/StoryMaker_1/output_results
STORYMAKER_EXPORT_DIR=/home/bourne/StoryMaker_1/exports
STORYMAKER_BACKUP_DIR=/home/bourne/StoryMaker_1/backups

# [Docker Compose 볼륨 바인딩 시 권장값 (컨테이너 내부 경로)]
# STORYMAKER_DB_PATH=/app/data/storymaker.db
# STORYMAKER_PERSONA_DIR=/app/personas
# STORYMAKER_OUTPUT_DIR=/app/output_results
# STORYMAKER_EXPORT_DIR=/app/exports
# STORYMAKER_BACKUP_DIR=/app/backups

# ------------------------------------------------------------------------------
# 운영 및 계정 보안 설정 (실제 서비스 운영 단계 진입 시 패스워드를 반드시 변경하십시오)
# ------------------------------------------------------------------------------
STORYMAKER_ADMIN_USER=admin
STORYMAKER_ADMIN_PASSWORD=change-me
